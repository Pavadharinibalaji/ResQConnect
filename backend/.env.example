# ResQConnect backend configuration template.
#
# Copy to `.env` for local development:  cp .env.example .env
# `.env` (and every other .env.* file) is local-only and git-ignored; only this
# placeholder template is committed. Staging/production values are supplied by the
# deployment (e.g. docker-compose `env_file`, container secrets), never committed.

PROJECT_NAME="ResQConnect API"
VERSION="1.0.0"

# Required. One of: development, staging, production.
# Development-only behaviour (unverified Firebase token decoding) needs "development".
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
# Required, no default.
POSTGRES_PASSWORD="replace-with-your-local-database-password"
POSTGRES_DB="resqconnect"
POSTGRES_PORT="5432"

# Security
# Required, no default: at least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder below is rejected at startup on purpose.
SECRET_KEY="replace-with-a-long-random-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_HOSTS='["*"]'
CORS_ORIGINS='["http://localhost:3000", "http://localhost:8000"]'

# Firebase Admin SDK service-account file. Optional in development; required in
# staging/production (the server refuses to start without it). Never commit it.
FIREBASE_CREDENTIALS_PATH="path/to/firebase-service-account.json"
